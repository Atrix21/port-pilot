<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colour tokens, generated from the Windows app's Colors.Dark.xaml / Colors.Light.xaml so both apps share one palette. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Bg.Window" Color="#141416" />
            <SolidColorBrush x:Key="Bg.Panel" Color="#18181B" />
            <SolidColorBrush x:Key="Bg.Elevated" Color="#202024" />
            <SolidColorBrush x:Key="Bg.Input" Color="#1B1B1E" />
            <SolidColorBrush x:Key="Bg.Thumb" Color="#2C2C31" />
            <SolidColorBrush x:Key="Bg.Keycap" Color="#26262B" />
            <SolidColorBrush x:Key="Fill.Subtle" Color="#0BFFFFFF" />
            <SolidColorBrush x:Key="Fill.Hover" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="Fill.Pressed" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="Row.Hover" Color="#09FFFFFF" />
            <SolidColorBrush x:Key="Row.Selected" Color="#17E9A35C" />
            <SolidColorBrush x:Key="Skeleton" Color="#0EFFFFFF" />
            <SolidColorBrush x:Key="Stroke.Hairline" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="Stroke.Default" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="Stroke.Strong" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="Stroke.Elevated" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="Text.Primary" Color="#EDEDEF" />
            <SolidColorBrush x:Key="Text.Secondary" Color="#A1A1A9" />
            <SolidColorBrush x:Key="Text.Tertiary" Color="#6E6E77" />
            <SolidColorBrush x:Key="Text.Quaternary" Color="#4A4A51" />
            <SolidColorBrush x:Key="Accent" Color="#E9A35C" />
            <SolidColorBrush x:Key="Accent.Strong" Color="#F3B878" />
            <SolidColorBrush x:Key="Accent.Soft" Color="#21E9A35C" />
            <SolidColorBrush x:Key="Accent.Glow" Color="#14E9A35C" />
            <SolidColorBrush x:Key="Accent.On" Color="#1C1307" />
            <SolidColorBrush x:Key="Focus" Color="#E9A35C" />
            <SolidColorBrush x:Key="Positive" Color="#62C391" />
            <SolidColorBrush x:Key="Positive.Soft" Color="#1F62C391" />
            <SolidColorBrush x:Key="Negative" Color="#EE6E62" />
            <SolidColorBrush x:Key="Negative.Strong" Color="#F5877C" />
            <SolidColorBrush x:Key="Negative.Soft" Color="#1FEE6E62" />
            <SolidColorBrush x:Key="Caution" Color="#E2B657" />
            <SolidColorBrush x:Key="Caution.Soft" Color="#1CE2B657" />
            <SolidColorBrush x:Key="Protocol.Tcp" Color="#8DAEF3" />
            <SolidColorBrush x:Key="Protocol.Tcp.Soft" Color="#1A8DAEF3" />
            <SolidColorBrush x:Key="Protocol.Udp" Color="#BBA0F0" />
            <SolidColorBrush x:Key="Protocol.Udp.Soft" Color="#1ABBA0F0" />
            <SolidColorBrush x:Key="Toast.Bg" Color="#2A2A2F" />
            <SolidColorBrush x:Key="Toast.Stroke" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="Toast.Text" Color="#F2F2F3" />
            <SolidColorBrush x:Key="Toast.Muted" Color="#A1A1A9" />
            <SolidColorBrush x:Key="Scrim" Color="#A6070708" />
            <SolidColorBrush x:Key="Caption.CloseHover" Color="#C42B1C" />
            <Color x:Key="ShadowColor">#000000</Color>
            <Color x:Key="WindowBorderColor">#2A2A2E</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Bg.Window" Color="#F8F7F4" />
            <SolidColorBrush x:Key="Bg.Panel" Color="#FDFCFA" />
            <SolidColorBrush x:Key="Bg.Elevated" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Bg.Input" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Bg.Thumb" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Bg.Keycap" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fill.Subtle" Color="#0B2B2620" />
            <SolidColorBrush x:Key="Fill.Hover" Color="#122B2620" />
            <SolidColorBrush x:Key="Fill.Pressed" Color="#1A2B2620" />
            <SolidColorBrush x:Key="Row.Hover" Color="#082B2620" />
            <SolidColorBrush x:Key="Row.Selected" Color="#16B8661E" />
            <SolidColorBrush x:Key="Skeleton" Color="#0D2B2620" />
            <SolidColorBrush x:Key="Stroke.Hairline" Color="#142B2620" />
            <SolidColorBrush x:Key="Stroke.Default" Color="#1F2B2620" />
            <SolidColorBrush x:Key="Stroke.Strong" Color="#332B2620" />
            <SolidColorBrush x:Key="Stroke.Elevated" Color="#1A2B2620" />
            <SolidColorBrush x:Key="Text.Primary" Color="#1D1B18" />
            <SolidColorBrush x:Key="Text.Secondary" Color="#5E5A54" />
            <SolidColorBrush x:Key="Text.Tertiary" Color="#8E8982" />
            <SolidColorBrush x:Key="Text.Quaternary" Color="#B9B4AD" />
            <SolidColorBrush x:Key="Accent" Color="#B5641D" />
            <SolidColorBrush x:Key="Accent.Strong" Color="#9C5417" />
            <SolidColorBrush x:Key="Accent.Soft" Color="#1CB5641D" />
            <SolidColorBrush x:Key="Accent.Glow" Color="#12B5641D" />
            <SolidColorBrush x:Key="Accent.On" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Focus" Color="#B5641D" />
            <SolidColorBrush x:Key="Positive" Color="#2B8656" />
            <SolidColorBrush x:Key="Positive.Soft" Color="#1A2B8656" />
            <SolidColorBrush x:Key="Negative" Color="#C2412D" />
            <SolidColorBrush x:Key="Negative.Strong" Color="#A93524" />
            <SolidColorBrush x:Key="Negative.Soft" Color="#16C2412D" />
            <SolidColorBrush x:Key="Caution" Color="#9E7210" />
            <SolidColorBrush x:Key="Caution.Soft" Color="#1A9E7210" />
            <SolidColorBrush x:Key="Protocol.Tcp" Color="#3A67C6" />
            <SolidColorBrush x:Key="Protocol.Tcp.Soft" Color="#143A67C6" />
            <SolidColorBrush x:Key="Protocol.Udp" Color="#7D4EBD" />
            <SolidColorBrush x:Key="Protocol.Udp.Soft" Color="#147D4EBD" />
            <SolidColorBrush x:Key="Toast.Bg" Color="#22201D" />
            <SolidColorBrush x:Key="Toast.Stroke" Color="#22201D" />
            <SolidColorBrush x:Key="Toast.Text" Color="#F7F5F2" />
            <SolidColorBrush x:Key="Toast.Muted" Color="#ABA59D" />
            <SolidColorBrush x:Key="Scrim" Color="#4D1D1B18" />
            <SolidColorBrush x:Key="Caption.CloseHover" Color="#C42B1C" />
            <Color x:Key="ShadowColor">#3B2F22</Color>
            <Color x:Key="WindowBorderColor">#DCD8D2</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Type families. Inter ships with the app; mono falls back through common Linux fonts. -->
    <FontFamily x:Key="Font.UI">fonts:Inter#Inter, $Default</FontFamily>
    <FontFamily x:Key="Font.Mono">JetBrains Mono, Cascadia Mono, Fira Code, Ubuntu Mono, DejaVu Sans Mono, monospace</FontFamily>

    <!-- Type scale: 11 micro · 12 caption · 13 body · 15 title · 20 heading · 24 display -->
    <x:Double x:Key="Type.Micro">11</x:Double>
    <x:Double x:Key="Type.Caption">12</x:Double>
    <x:Double x:Key="Type.Body">13</x:Double>
    <x:Double x:Key="Type.Title">15</x:Double>
    <x:Double x:Key="Type.Heading">20</x:Double>
    <x:Double x:Key="Type.Display">24</x:Double>

</ResourceDictionary>
