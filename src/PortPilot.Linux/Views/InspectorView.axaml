<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:PortPilot.Linux.Controls"
             xmlns:vm="using:PortPilot.App.ViewModels"
             x:Class="PortPilot.Linux.Views.InspectorView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="TextBlock.key">
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style Selector=":is(TextBlock).value">
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
        <Style Selector="Grid.fact">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Ellipse.state">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource Text.Tertiary}" />
        </Style>
        <Style Selector="Ellipse.state.up">
            <Setter Property="Fill" Value="{DynamicResource Positive}" />
        </Style>
        <Style Selector="Ellipse.state.connected">
            <Setter Property="Fill" Value="{DynamicResource Protocol.Tcp}" />
        </Style>
        <Style Selector="Ellipse.state.closed">
            <Setter Property="Fill" Value="{DynamicResource Negative}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ───── Identity ───── -->
        <Grid Margin="24,22,16,0" ColumnDefinitions="Auto,*,Auto">
            <c:ProcessIcon Width="44" Height="44" VerticalAlignment="Top" FontSize="18" CornerRadius="10" NameText="{Binding Inspector.Row.ProcessName}" Path="{Binding Inspector.Row.ExecutablePath}" />
            <StackPanel Grid.Column="1" Margin="14,1,8,0" VerticalAlignment="Center">
                <TextBlock Classes="heading" Text="{Binding Inspector.Row.ProcessName}" />
                <TextBlock Margin="0,3,0,0" Classes="caption" Text="{Binding Inspector.Description}" IsVisible="{Binding Inspector.Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Margin="0,3,0,0" Classes="caption" Text="{Binding Inspector.Row.ImageName}" IsVisible="{Binding Inspector.Description, Converter={x:Static ObjectConverters.IsNull}}" />
            </StackPanel>
            <Button Grid.Column="2" VerticalAlignment="Top" Classes="icon-small" Command="{Binding CloseInspectorCommand}" ToolTip.Tip="Close  ·  Esc">
                <c:Icon Data="{StaticResource Icon.Close}" Size="15" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,24">
                <!-- Tags -->
                <WrapPanel Margin="0,0,0,18">
                    <Border Classes="tag">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="micro" Text="PID" />
                            <TextBlock FontSize="11" Classes="mono" Text="{Binding Inspector.Row.PidText}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="tag" IsVisible="{Binding Inspector.Row.StartTime, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="micro" Text="Up" />
                            <TextBlock FontSize="11" Classes="mono" Text="{Binding Inspector.UptimeText}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="tag" Background="{DynamicResource Accent.Soft}" BorderThickness="0" IsVisible="{Binding Inspector.Row.IsDevPort, FallbackValue=False}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Text="{Binding Inspector.Row.KnownName}" />
                    </Border>
                    <Border Classes="tag" Background="{DynamicResource Negative.Soft}" BorderThickness="0" IsVisible="{Binding Inspector.Row.IsClosed, FallbackValue=False}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Negative}" Text="Port closed" />
                    </Border>
                </WrapPanel>

                <!-- Primary actions -->
                <Grid Margin="0,0,0,26" ColumnDefinitions="*,Auto,Auto">
                    <Button Classes="primary" HorizontalAlignment="Stretch" Command="{Binding OpenInBrowserCommand}" CommandParameter="{Binding Inspector.Row}"
                            ToolTip.Tip="Open in your default browser  ·  Ctrl+Enter" IsVisible="{Binding Inspector.Row.CanOpenInBrowser, FallbackValue=False}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:Icon Data="{StaticResource Icon.External}" Size="15" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding Inspector.Row.UrlDisplay, StringFormat='Open {0}'}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Width="32" Height="32" Margin="8,0,0,0" Padding="0" Classes="secondary"
                            Command="{Binding CopyDetailsCommand}" CommandParameter="{Binding Inspector.Row}" ToolTip.Tip="Copy details  ·  Ctrl+C">
                        <c:Icon Data="{StaticResource Icon.Copy}" Size="15" />
                    </Button>
                    <Button Grid.Column="2" Width="32" Height="32" Margin="8,0,0,0" Padding="0" Classes="secondary"
                            Command="{Binding RevealCommand}" CommandParameter="{Binding Inspector.Row}" ToolTip.Tip="Show in file manager  ·  Ctrl+E">
                        <c:Icon Data="{StaticResource Icon.Folder}" Size="15" />
                    </Button>
                </Grid>

                <!-- Endpoint -->
                <TextBlock Classes="label section" Text="Endpoint" />
                <Grid Classes="fact" ColumnDefinitions="92,*">
                    <TextBlock Classes="key" Text="Port" />
                    <TextBlock Grid.Column="1" Classes="value mono" Text="{Binding Inspector.Row.PortText}" />
                </Grid>
                <Grid Classes="fact" ColumnDefinitions="92,*">
                    <TextBlock Classes="key" Text="Protocol" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Border Classes="pill" Classes.udp="{Binding !Inspector.Row.IsTcp, FallbackValue=False}">
                            <TextBlock Text="{Binding Inspector.Row.ProtocolText}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" Classes="value" Text="{Binding Inspector.Row.FamilyText}" />
                    </StackPanel>
                </Grid>
                <Grid Classes="fact" ColumnDefinitions="92,*">
                    <TextBlock Classes="key" Text="Local address" />
                    <StackPanel Grid.Column="1">
                        <SelectableTextBlock Classes="value mono" Text="{Binding Inspector.Row.EndpointText}" />
                        <TextBlock Margin="0,2,0,0" Classes="micro" Text="{Binding Inspector.Row.AddressScope}" />
                    </StackPanel>
                </Grid>
                <Grid Classes="fact" ColumnDefinitions="92,*">
                    <TextBlock Classes="key" Text="State" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Ellipse VerticalAlignment="Center" Classes="state"
                                 Classes.up="{Binding Inspector.Row.IsListening, FallbackValue=False}"
                                 Classes.connected="{Binding Inspector.Row.State, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=Established, FallbackValue=False}"
                                 Classes.closed="{Binding Inspector.Row.IsClosed, FallbackValue=False}" />
                        <TextBlock Classes="value" Text="{Binding Inspector.Row.StateText}" />
                    </StackPanel>
                </Grid>

                <Grid Classes="fact" ColumnDefinitions="92,*" IsVisible="{Binding Inspector.CanCheckHealth}">
                    <TextBlock Classes="key" Text="Health" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Ellipse VerticalAlignment="Center" Classes="health" Classes.ok="{Binding Inspector.IsHealthy}" Classes.bad="{Binding Inspector.IsUnhealthy}" />
                        <TextBlock VerticalAlignment="Center" Classes="value" Text="{Binding Inspector.HealthText}" />
                        <Button Classes="icon-small" Width="22" Height="22" Margin="-2,-4,0,-4" Command="{Binding Inspector.RefreshHealthCommand}" ToolTip.Tip="Check again">
                            <c:Icon Data="{StaticResource Icon.Refresh}" Size="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Margin="0,8,0,20" Classes="divider" />

                <!-- Process -->
                <TextBlock Classes="label section" Text="Process" />

                <Border Classes="callout" Background="{DynamicResource Caution.Soft}" IsVisible="{Binding Inspector.Row.IsRestricted, FallbackValue=False}">
                    <Grid ColumnDefinitions="Auto,*">
                        <c:Icon Margin="0,1,10,0" VerticalAlignment="Top" Data="{StaticResource Icon.Lock}" Foreground="{DynamicResource Caution}" Size="15" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Classes="value" Text="Limited information" />
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Text.Secondary}" Classes="value"
                                       Text="This socket belongs to another user. Linux only shows its owner, path and command line to root." />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Left" Classes="link" Command="{Binding RestartAsAdminCommand}" Content="Restart as root" IsVisible="{Binding !IsElevated}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="callout" Background="{DynamicResource Fill.Subtle}" IsVisible="{Binding Inspector.Row.IsSystem, FallbackValue=False}">
                    <Grid ColumnDefinitions="Auto,*">
                        <c:Icon Margin="0,1,10,0" VerticalAlignment="Top" Data="{StaticResource Icon.Cpu}" Foreground="{DynamicResource Text.Secondary}" Size="15" />
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource Text.Secondary}" Classes="value" Text="A kernel thread. It can't be stopped from user space." />
                    </Grid>
                </Border>

                <Grid Classes="fact" ColumnDefinitions="92,*" IsVisible="{Binding Inspector.Row.HasExecutablePath, FallbackValue=False}">
                    <TextBlock Classes="key" Text="Executable" />
                    <SelectableTextBlock Grid.Column="1" Classes="value mono" Text="{Binding Inspector.Row.ExecutablePath}" />
                </Grid>
                <Grid Classes="fact" ColumnDefinitions="92,*">
                    <TextBlock Classes="key" Text="Started" />
                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding Inspector.StartedText}" />
                </Grid>
                <Grid Classes="fact" ColumnDefinitions="92,*" IsVisible="{Binding Inspector.HasPublisher}">
                    <TextBlock Classes="key" Text="Publisher" />
                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding Inspector.PublisherText}" />
                </Grid>

                <StackPanel Margin="0,4,0,0" IsVisible="{Binding Inspector.Row.CommandLine, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                    <TextBlock Margin="0,0,0,8" Classes="key" Text="Command line" />
                    <Border Padding="11,9" Background="{DynamicResource Fill.Subtle}" BorderBrush="{DynamicResource Stroke.Hairline}" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer MaxHeight="96" HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock Classes="value mono" Foreground="{DynamicResource Text.Secondary}" Text="{Binding Inspector.Row.CommandLine}" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Project & agent -->
                <StackPanel Margin="0,22,0,0" IsVisible="{Binding Inspector.Row.HasProject, FallbackValue=False}">
                    <Border Margin="0,0,0,20" Classes="divider" />
                    <TextBlock Classes="label section" Text="Project" />
                    <Grid Classes="fact" ColumnDefinitions="92,*">
                        <TextBlock Classes="key" Text="Repository" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="value" FontWeight="SemiBold" Text="{Binding Inspector.Row.ProjectName}" />
                            <Border Classes="tag" Margin="0" Padding="5,0" IsVisible="{Binding Inspector.Row.IsWorktree, FallbackValue=False}">
                                <TextBlock Classes="micro" Text="worktree" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Classes="fact" ColumnDefinitions="92,*" IsVisible="{Binding Inspector.Row.ProjectBranch, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                        <TextBlock Classes="key" Text="Branch" />
                        <SelectableTextBlock Grid.Column="1" Classes="value mono" Text="{Binding Inspector.Row.ProjectBranch}" />
                    </Grid>
                    <Grid Classes="fact" ColumnDefinitions="92,*">
                        <TextBlock Classes="key" Text="Folder" />
                        <SelectableTextBlock Grid.Column="1" Classes="value mono" Text="{Binding Inspector.Row.WorkingDirectory}" />
                    </Grid>
                </StackPanel>

                <Border Margin="0,8,0,0" Classes="callout" Background="{DynamicResource Accent.Soft}" IsVisible="{Binding Inspector.Row.Agent.IsRunning, FallbackValue=False}">
                    <Grid ColumnDefinitions="Auto,*">
                        <c:Icon Margin="0,1,10,0" VerticalAlignment="Top" Data="{StaticResource Icon.Agent}" Foreground="{DynamicResource Accent}" Size="15" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding Inspector.Row.AgentText}" />
                    </Grid>
                </Border>
                <Border Margin="0,8,0,0" Classes="callout" Background="{DynamicResource Caution.Soft}" IsVisible="{Binding Inspector.Row.IsOrphaned, FallbackValue=False}">
                    <Grid ColumnDefinitions="Auto,*">
                        <c:Icon Margin="0,1,10,0" VerticalAlignment="Top" Data="{StaticResource Icon.Agent}" Foreground="{DynamicResource Caution}" Size="15" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Classes="value" Text="Left behind" />
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Text.Secondary}" Classes="value"
                                       Text="{Binding Inspector.Row.AgentText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Output -->
                <StackPanel Margin="0,22,0,0">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center" Classes="label" Text="Output" />
                        <Button Grid.Column="1" Classes="icon-small" Width="22" Height="22" Command="{Binding Inspector.RefreshLogsCommand}" ToolTip.Tip="Read again">
                            <c:Icon Data="{StaticResource Icon.Refresh}" Size="12" />
                        </Button>
                    </Grid>
                    <TextBlock Margin="0,0,0,6" Classes="micro mono" Text="{Binding Inspector.LogSource}" IsVisible="{Binding Inspector.HasLogs}" />
                    <Border Padding="11,9" Background="{DynamicResource Fill.Subtle}" BorderBrush="{DynamicResource Stroke.Hairline}" BorderThickness="1" CornerRadius="8" IsVisible="{Binding Inspector.HasLogs}">
                        <ScrollViewer Name="LogScroll" MaxHeight="180" HorizontalScrollBarVisibility="Auto">
                            <SelectableTextBlock FontSize="11" Classes="mono" Foreground="{DynamicResource Text.Secondary}" TextWrapping="NoWrap" TextTrimming="None" Text="{Binding Inspector.LogText}" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock Classes="caption wrap" Foreground="{DynamicResource Text.Tertiary}" Text="{Binding Inspector.LogUnavailable}" IsVisible="{Binding !Inspector.HasLogs}" />
                </StackPanel>

                <!-- Siblings -->
                <StackPanel Margin="0,22,0,0" IsVisible="{Binding Inspector.HasSiblings}">
                    <TextBlock Classes="label section" Text="Also listening" />
                    <ItemsControl ItemsSource="{Binding Inspector.Siblings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PortRowViewModel">
                                <Button Height="28" Margin="0,0,6,6" Padding="9,0,10,0" Classes="secondary" Click="OnSiblingClick" ToolTip.Tip="{Binding EndpointText}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock FontSize="12" Classes="mono" Text="{Binding PortText, StringFormat=':{0}'}" VerticalAlignment="Center" />
                                        <TextBlock VerticalAlignment="Center" Classes="micro" Text="{Binding ProtocolFamilyText}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ───── Danger zone ───── -->
        <Border Grid.Row="2" Padding="24,14,24,18" BorderBrush="{DynamicResource Stroke.Hairline}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="caption" Foreground="{DynamicResource Text.Primary}" Text="Terminate process" />
                    <TextBlock Margin="0,2,0,0" Classes="micro" Text="{Binding Inspector.TerminateHint}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="danger" Command="{Binding TerminateCommand}" CommandParameter="{Binding Inspector.Row}"
                        IsEnabled="{Binding !Inspector.IsProtected}" ToolTip.Tip="Terminate process  ·  Del">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <c:Icon Data="{StaticResource Icon.Power}" Size="15" VerticalAlignment="Center" />
                        <TextBlock Text="Terminate" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
