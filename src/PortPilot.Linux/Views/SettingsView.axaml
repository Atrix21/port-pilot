<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:PortPilot.Linux.Controls"
             xmlns:vm="using:PortPilot.App.ViewModels"
             x:Class="PortPilot.Linux.Views.SettingsView"
             x:DataType="vm:MainViewModel"
             Width="540">
    <UserControl.Styles>
        <Style Selector="TextBlock.row-caption">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
        <Style Selector="Grid.setting">
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style Selector="Grid.setting > ToggleSwitch">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Border Classes="card">
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid Margin="28,22,18,6">
                <TextBlock VerticalAlignment="Center" Classes="heading" Text="Settings" />
                <Button HorizontalAlignment="Right" Classes="icon" Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="Close  ·  Esc">
                    <c:Icon Data="{StaticResource Icon.Close}" Size="16" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="520" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,12,28,8">
                    <!-- Appearance -->
                    <TextBlock Margin="0,0,0,4" Classes="label" Text="Appearance" />
                    <Grid Classes="setting" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="body" Text="Theme" />
                            <TextBlock Classes="row-caption" Text="Follow the desktop or keep a fixed look." />
                        </StackPanel>
                        <Border Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Classes="segmented">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Classes="segment" Content="System" GroupName="Theme" IsChecked="{Binding Settings.Theme, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=System}" />
                                <RadioButton Classes="segment" Content="Light" GroupName="Theme" IsChecked="{Binding Settings.Theme, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=Light}" />
                                <RadioButton Classes="segment" Content="Dark" GroupName="Theme" IsChecked="{Binding Settings.Theme, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=Dark}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Margin="0,22,0,20" Classes="divider" />

                    <!-- Monitoring -->
                    <TextBlock Margin="0,0,0,4" Classes="label" Text="Monitoring" />
                    <Grid Classes="setting" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="body" Text="Refresh interval" />
                            <TextBlock Classes="row-caption" Text="How often the port table is rescanned." />
                        </StackPanel>
                        <Border Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Classes="segmented">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Classes="segment" Content="1s" GroupName="Interval" IsChecked="{Binding Settings.RefreshIntervalSeconds, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=1}" />
                                <RadioButton Classes="segment" Content="2s" GroupName="Interval" IsChecked="{Binding Settings.RefreshIntervalSeconds, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=2}" />
                                <RadioButton Classes="segment" Content="5s" GroupName="Interval" IsChecked="{Binding Settings.RefreshIntervalSeconds, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=5}" />
                                <RadioButton Classes="segment" Content="10s" GroupName="Interval" IsChecked="{Binding Settings.RefreshIntervalSeconds, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=10}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Classes="setting" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="body" Text="Notify when a dev server starts" />
                            <TextBlock Classes="row-caption" Text="A desktop notification when a port like 3000 or 5173 opens while PortPilot is in the tray." />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.NotifyOnNewDevPorts}" />
                    </Grid>

                    <Border Margin="0,22,0,20" Classes="divider" />

                    <!-- Coding agents -->
                    <TextBlock Margin="0,0,0,4" Classes="label" Text="Coding agents" />
                    <TextBlock Classes="row-caption" Text="{Binding Settings.BuiltInAgentsText, StringFormat='PortPilot recognises {0}.'}" />
                    <TextBlock Margin="0,8,0,0" Classes="row-caption" Foreground="{DynamicResource Caution}" Text="{Binding Settings.IntegrationUnavailableText}" IsVisible="{Binding !Settings.CanIntegrate}" />
                    <Grid Classes="setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding Settings.CanIntegrate}">
                        <StackPanel>
                            <TextBlock Classes="body" Text="Record Claude Code sessions" />
                            <TextBlock Classes="row-caption" Text="A session-end hook records what each session started, so leftovers are recognised even if PortPilot wasn't running." />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.HookInstalled}" />
                    </Grid>
                    <Grid Classes="setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding Settings.CanIntegrate}">
                        <StackPanel>
                            <TextBlock Classes="body" Text="Stop leftovers when a session ends" />
                            <TextBlock Classes="row-caption" Text="The hook also stops anything the session left holding a port." />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.HookStopsLeftovers}" />
                    </Grid>
                    <Grid Classes="setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding Settings.CanIntegrate}">
                        <StackPanel>
                            <TextBlock Classes="body" Text="Background watcher" />
                            <TextBlock Classes="row-caption" Text="A tiny service that starts at login and records every agent session, for agents without hooks." />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.WatcherInstalled}" />
                    </Grid>
                    <Grid Classes="setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding Settings.CanIntegrate}">
                        <StackPanel>
                            <TextBlock Classes="body" Text="Let Claude ask PortPilot (MCP)" />
                            <TextBlock Classes="row-caption" Text="Claude Code can check ports, project status, health and logs, and find free ports, instead of guessing." />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.McpRegistered}" />
                    </Grid>
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Classes="body" Text="Other agents" />
                        <TextBlock Classes="row-caption" Text="Executable names to recognise as agents too, separated by commas." />
                        <TextBox Margin="0,8,0,0" Text="{Binding Settings.CustomAgentsText}" Watermark="e.g. my-agent, devin" FontSize="{StaticResource Type.Caption}" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" Classes="row-caption" Foreground="{DynamicResource Text.Secondary}" Text="{Binding Settings.IntegrationMessage}" IsVisible="{Binding Settings.IntegrationMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <Border Margin="0,22,0,20" Classes="divider" />

                    <!-- Startup and tray -->
                    <TextBlock Margin="0,0,0,4" Classes="label" Text="Startup and tray" />
                    <Grid Classes="setting" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Classes="body" Text="Start on login" />
                            <TextBlock Classes="row-caption" Text="Launch quietly into the tray when you sign in." />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.StartWithWindows}" />
                    </Grid>
                    <Grid Classes="setting" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="body" Text="Start in the tray" />
                            <TextBlock Classes="row-caption" Text="Don't open the window when PortPilot starts." />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.StartMinimized}" />
                    </Grid>
                    <Grid Classes="setting" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="body" Text="Keep running when closed" />
                            <TextBlock Classes="row-caption" Text="Closing the window leaves PortPilot in the tray. Quit from the tray menu or with Ctrl+Q. Needs a desktop with tray icons." />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.CloseToTray}" />
                    </Grid>
                    <Grid Classes="setting" ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Classes="body" Text="Minimize to tray" />
                            <TextBlock Classes="row-caption" Text="Minimizing hides the window instead of keeping it in the dock." />
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding Settings.MinimizeToTray}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Margin="0,14,0,0" Padding="28,14,28,16" BorderBrush="{DynamicResource Stroke.Hairline}" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Classes="caption" Foreground="{DynamicResource Text.Primary}" Text="PortPilot" />
                        <TextBlock Classes="caption" Foreground="{DynamicResource Text.Tertiary}" Text="{x:Static vm:SettingsViewModel.VersionText}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="16">
                        <Button Classes="link" Command="{Binding Settings.OpenLogsCommand}" Content="Open logs" />
                        <Button Classes="link" Command="{Binding Settings.OpenSettingsFileCommand}" Content="Settings file" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
