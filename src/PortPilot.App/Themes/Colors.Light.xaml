<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- PortPilot · Light. Warm paper tones with a deeper, ink-like amber. -->

    <!-- Surfaces, from back to front -->
    <SolidColorBrush x:Key="Bg.Window" Color="#F8F7F4" po:Freeze="True" />
    <SolidColorBrush x:Key="Bg.Panel" Color="#FDFCFA" po:Freeze="True" />
    <SolidColorBrush x:Key="Bg.Elevated" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Bg.Input" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Bg.Thumb" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Bg.Keycap" Color="#FFFFFF" po:Freeze="True" />

    <!-- Interactive fills -->
    <SolidColorBrush x:Key="Fill.Subtle" Color="#0B2B2620" po:Freeze="True" />
    <SolidColorBrush x:Key="Fill.Hover" Color="#122B2620" po:Freeze="True" />
    <SolidColorBrush x:Key="Fill.Pressed" Color="#1A2B2620" po:Freeze="True" />
    <SolidColorBrush x:Key="Row.Hover" Color="#082B2620" po:Freeze="True" />
    <SolidColorBrush x:Key="Row.Selected" Color="#16B8661E" po:Freeze="True" />
    <SolidColorBrush x:Key="Skeleton" Color="#0D2B2620" po:Freeze="True" />

    <!-- Strokes -->
    <SolidColorBrush x:Key="Stroke.Hairline" Color="#142B2620" po:Freeze="True" />
    <SolidColorBrush x:Key="Stroke.Default" Color="#1F2B2620" po:Freeze="True" />
    <SolidColorBrush x:Key="Stroke.Strong" Color="#332B2620" po:Freeze="True" />
    <SolidColorBrush x:Key="Stroke.Elevated" Color="#1A2B2620" po:Freeze="True" />

    <!-- Text -->
    <SolidColorBrush x:Key="Text.Primary" Color="#1D1B18" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#5E5A54" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#8E8982" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Quaternary" Color="#B9B4AD" po:Freeze="True" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent" Color="#B5641D" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Strong" Color="#9C5417" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#1CB5641D" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Glow" Color="#12B5641D" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.On" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Focus" Color="#B5641D" po:Freeze="True" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="Positive" Color="#2B8656" po:Freeze="True" />
    <SolidColorBrush x:Key="Positive.Soft" Color="#1A2B8656" po:Freeze="True" />
    <SolidColorBrush x:Key="Negative" Color="#C2412D" po:Freeze="True" />
    <SolidColorBrush x:Key="Negative.Strong" Color="#A93524" po:Freeze="True" />
    <SolidColorBrush x:Key="Negative.Soft" Color="#16C2412D" po:Freeze="True" />
    <SolidColorBrush x:Key="Caution" Color="#9E7210" po:Freeze="True" />
    <SolidColorBrush x:Key="Caution.Soft" Color="#1A9E7210" po:Freeze="True" />

    <!-- Protocols -->
    <SolidColorBrush x:Key="Protocol.Tcp" Color="#3A67C6" po:Freeze="True" />
    <SolidColorBrush x:Key="Protocol.Tcp.Soft" Color="#143A67C6" po:Freeze="True" />
    <SolidColorBrush x:Key="Protocol.Udp" Color="#7D4EBD" po:Freeze="True" />
    <SolidColorBrush x:Key="Protocol.Udp.Soft" Color="#147D4EBD" po:Freeze="True" />

    <!-- Toasts: a quiet dark HUD in both themes -->
    <SolidColorBrush x:Key="Toast.Bg" Color="#22201D" po:Freeze="True" />
    <SolidColorBrush x:Key="Toast.Stroke" Color="#22201D" po:Freeze="True" />
    <SolidColorBrush x:Key="Toast.Text" Color="#F7F5F2" po:Freeze="True" />
    <SolidColorBrush x:Key="Toast.Muted" Color="#ABA59D" po:Freeze="True" />

    <!-- Chrome -->
    <SolidColorBrush x:Key="Scrim" Color="#4D1D1B18" po:Freeze="True" />
    <SolidColorBrush x:Key="Caption.CloseHover" Color="#C42B1C" po:Freeze="True" />
    <Color x:Key="ShadowColor">#3B2F22</Color>
    <Color x:Key="WindowBorderColor">#DCD8D2</Color>
    <sys:Double x:Key="ShadowOpacity">0.16</sys:Double>
    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>

</ResourceDictionary>
