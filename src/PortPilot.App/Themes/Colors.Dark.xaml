<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- PortPilot · Dark. Deep charcoal with warm amber as the single accent. -->

    <!-- Surfaces, from back to front -->
    <SolidColorBrush x:Key="Bg.Window" Color="#141416" po:Freeze="True" />
    <SolidColorBrush x:Key="Bg.Panel" Color="#18181B" po:Freeze="True" />
    <SolidColorBrush x:Key="Bg.Elevated" Color="#202024" po:Freeze="True" />
    <SolidColorBrush x:Key="Bg.Input" Color="#1B1B1E" po:Freeze="True" />
    <SolidColorBrush x:Key="Bg.Thumb" Color="#2C2C31" po:Freeze="True" />
    <SolidColorBrush x:Key="Bg.Keycap" Color="#26262B" po:Freeze="True" />

    <!-- Interactive fills (translucent so they compose over any surface) -->
    <SolidColorBrush x:Key="Fill.Subtle" Color="#0BFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Fill.Hover" Color="#12FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Fill.Pressed" Color="#08FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Row.Hover" Color="#09FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Row.Selected" Color="#17E9A35C" po:Freeze="True" />
    <SolidColorBrush x:Key="Skeleton" Color="#0EFFFFFF" po:Freeze="True" />

    <!-- Strokes -->
    <SolidColorBrush x:Key="Stroke.Hairline" Color="#0FFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Stroke.Default" Color="#17FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Stroke.Strong" Color="#26FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Stroke.Elevated" Color="#1FFFFFFF" po:Freeze="True" />

    <!-- Text -->
    <SolidColorBrush x:Key="Text.Primary" Color="#EDEDEF" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#A1A1A9" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#6E6E77" po:Freeze="True" />
    <SolidColorBrush x:Key="Text.Quaternary" Color="#4A4A51" po:Freeze="True" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent" Color="#E9A35C" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Strong" Color="#F3B878" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#21E9A35C" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.Glow" Color="#14E9A35C" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent.On" Color="#1C1307" po:Freeze="True" />
    <SolidColorBrush x:Key="Focus" Color="#E9A35C" po:Freeze="True" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="Positive" Color="#62C391" po:Freeze="True" />
    <SolidColorBrush x:Key="Positive.Soft" Color="#1F62C391" po:Freeze="True" />
    <SolidColorBrush x:Key="Negative" Color="#EE6E62" po:Freeze="True" />
    <SolidColorBrush x:Key="Negative.Strong" Color="#F5877C" po:Freeze="True" />
    <SolidColorBrush x:Key="Negative.Soft" Color="#1FEE6E62" po:Freeze="True" />
    <SolidColorBrush x:Key="Caution" Color="#E2B657" po:Freeze="True" />
    <SolidColorBrush x:Key="Caution.Soft" Color="#1CE2B657" po:Freeze="True" />

    <!-- Protocols -->
    <SolidColorBrush x:Key="Protocol.Tcp" Color="#8DAEF3" po:Freeze="True" />
    <SolidColorBrush x:Key="Protocol.Tcp.Soft" Color="#1A8DAEF3" po:Freeze="True" />
    <SolidColorBrush x:Key="Protocol.Udp" Color="#BBA0F0" po:Freeze="True" />
    <SolidColorBrush x:Key="Protocol.Udp.Soft" Color="#1ABBA0F0" po:Freeze="True" />

    <!-- Toasts: a quiet dark HUD in both themes -->
    <SolidColorBrush x:Key="Toast.Bg" Color="#2A2A2F" po:Freeze="True" />
    <SolidColorBrush x:Key="Toast.Stroke" Color="#1FFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Toast.Text" Color="#F2F2F3" po:Freeze="True" />
    <SolidColorBrush x:Key="Toast.Muted" Color="#A1A1A9" po:Freeze="True" />

    <!-- Chrome -->
    <SolidColorBrush x:Key="Scrim" Color="#A6070708" po:Freeze="True" />
    <SolidColorBrush x:Key="Caption.CloseHover" Color="#C42B1C" po:Freeze="True" />
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="WindowBorderColor">#2A2A2E</Color>
    <sys:Double x:Key="ShadowOpacity">0.45</sys:Double>
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>

</ResourceDictionary>
