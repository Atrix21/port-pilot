<Application x:Class="PortPilot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PortPilot.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the active colour dictionary; ThemeService swaps it at runtime. -->
                <ResourceDictionary Source="Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="Themes/Foundation.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Table.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:VisibleWhenConverter x:Key="VisibleWhen" />
            <conv:VisibleWhenConverter x:Key="HiddenWhen" Invert="True" />
            <conv:EqualsConverter x:Key="Equals" />
            <conv:NotConverter x:Key="Not" />
            <conv:SortTagConverter x:Key="SortTag" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
