<UserControl x:Class="PortPilot.App.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:PortPilot.App.Controls"
             xmlns:vm="clr-namespace:PortPilot.App.ViewModels;assembly=PortPilot.Presentation"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignHeight="760"
             d:DesignWidth="372"
             AutomationProperties.Name="Process inspector">

    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Key" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
        <Style x:Key="FactRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Body" DataContext="{Binding Inspector}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ───── Identity ───── -->
        <Grid Margin="24,22,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:ProcessIcon Width="44" Height="44" VerticalAlignment="Top" FontSize="18" NameText="{Binding Row.ProcessName}" Path="{Binding Row.ExecutablePath}" />
            <StackPanel Grid.Column="1" Margin="14,1,8,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding Row.ProcessName}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Description}" Visibility="{Binding Description, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Row.ImageName}" Visibility="{Binding Description, Converter={StaticResource HiddenWhen}}" />
            </StackPanel>
            <Button Grid.Column="2"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Close inspector"
                    Command="{Binding DataContext.CloseInspectorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource Button.IconSmall}"
                    ToolTip="Close  ·  Esc"
                    ui:Ui.Icon="{StaticResource Icon.Close}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,24">

                <!-- Tags -->
                <WrapPanel Margin="0,0,0,18">
                    <Border Margin="0,0,6,6" Padding="8,3" Background="{DynamicResource Fill.Subtle}" BorderBrush="{DynamicResource Stroke.Hairline}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Micro}" Text="PID" />
                            <TextBlock Margin="6,0,0,0" FontSize="11" Style="{StaticResource Text.Mono}" Text="{Binding Row.PidText}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,6,6" Padding="8,3" Background="{DynamicResource Fill.Subtle}" BorderBrush="{DynamicResource Stroke.Hairline}" BorderThickness="1" CornerRadius="6"
                            Visibility="{Binding Row.StartTime, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Micro}" Text="Up" />
                            <TextBlock Margin="6,0,0,0" FontSize="11" Style="{StaticResource Text.Mono}" Text="{Binding UptimeText}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,6,6" Padding="8,3" Background="{DynamicResource Accent.Soft}" CornerRadius="6" Visibility="{Binding Row.IsDevPort, Converter={StaticResource VisibleWhen}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Style="{StaticResource Text.Base}" Text="{Binding Row.KnownName}" />
                    </Border>
                    <Border Margin="0,0,6,6" Padding="8,3" Background="{DynamicResource Negative.Soft}" CornerRadius="6" Visibility="{Binding Row.IsClosed, Converter={StaticResource VisibleWhen}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Negative}" Style="{StaticResource Text.Base}" Text="Port closed" />
                    </Border>
                </WrapPanel>

                <!-- Primary actions -->
                <Grid Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button HorizontalContentAlignment="Center"
                            Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Row}"
                            Style="{StaticResource Button.Primary}"
                            ToolTip="Open in your default browser  ·  Ctrl+Enter"
                            Visibility="{Binding Row.CanOpenInBrowser, Converter={StaticResource VisibleWhen}}"
                            ui:Ui.Icon="{StaticResource Icon.External}"
                            ui:Ui.IconSize="15">
                        <TextBlock Text="{Binding Row.UrlDisplay, StringFormat=Open {0}}" />
                    </Button>
                    <Button Grid.Column="1"
                            Width="32"
                            Height="32"
                            Margin="8,0,0,0"
                            Padding="0"
                            AutomationProperties.Name="Copy details"
                            Command="{Binding DataContext.CopyDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Row}"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Copy details  ·  Ctrl+C"
                            ui:Ui.Icon="{StaticResource Icon.Copy}"
                            ui:Ui.IconSize="15" />
                    <Button Grid.Column="2"
                            Width="32"
                            Height="32"
                            Margin="8,0,0,0"
                            Padding="0"
                            AutomationProperties.Name="Show in File Explorer"
                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Row}"
                            Style="{StaticResource Button.Secondary}"
                            ToolTip="Show in File Explorer  ·  Ctrl+E"
                            ui:Ui.Icon="{StaticResource Icon.Folder}"
                            ui:Ui.IconSize="15" />
                </Grid>

                <!-- Endpoint -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="Endpoint" />
                <Grid Style="{StaticResource FactRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Key}" Text="Port" />
                    <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Value}" Text="{Binding Row.PortText}" />
                </Grid>
                <Grid Style="{StaticResource FactRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Key}" Text="Protocol" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" DataContext="{Binding Row}">
                        <Border Style="{StaticResource ProtocolPill}">
                            <TextBlock Style="{StaticResource ProtocolPill.Text}" Text="{Binding ProtocolText}" />
                        </Border>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Value}" Text="{Binding FamilyText}" />
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource FactRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Key}" Text="Local address" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Value}" Text="{Binding Row.EndpointText}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Micro}" Text="{Binding Row.AddressScope}" />
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource FactRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Key}" Text="State" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" DataContext="{Binding Row}">
                        <Ellipse Margin="0,1,8,0" VerticalAlignment="Center" Style="{StaticResource StateDot}" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding StateText}" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource FactRow}" Visibility="{Binding CanCheckHealth, Converter={StaticResource VisibleWhen}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Key}" Text="Health" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,1,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Text.Tertiary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Positive}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUnhealthy}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Negative}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Value}" Text="{Binding HealthText}" />
                        <Button Width="22" Height="22" Margin="6,-4,0,-4" Command="{Binding RefreshHealthCommand}" Style="{StaticResource Button.IconSmall}" ToolTip="Check again" ui:Ui.Icon="{StaticResource Icon.Refresh}" ui:Ui.IconSize="12" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,8,0,20" Style="{StaticResource Divider}" />

                <!-- Process -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="Process" />

                <!-- Restricted callout -->
                <Border Margin="0,0,0,14"
                        Padding="12,11"
                        Background="{DynamicResource Caution.Soft}"
                        CornerRadius="9"
                        Visibility="{Binding Row.IsRestricted, Converter={StaticResource VisibleWhen}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Icon Margin="0,1,10,0" VerticalAlignment="Top" Data="{StaticResource Icon.Lock}" Foreground="{DynamicResource Caution}" Size="15" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource Value}" Text="Limited information" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Style="{StaticResource Value}"
                                       Text="Windows only shares the path, command line and start time of this process with administrators." />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding DataContext.RestartAsAdminCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="Restart as administrator"
                                    Style="{StaticResource Button.Link}"
                                    Visibility="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HiddenWhen}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- System callout -->
                <Border Margin="0,0,0,14"
                        Padding="12,11"
                        Background="{DynamicResource Fill.Subtle}"
                        CornerRadius="9"
                        Visibility="{Binding Row.IsSystem, Converter={StaticResource VisibleWhen}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Icon Margin="0,1,10,0" VerticalAlignment="Top" Data="{StaticResource Icon.Cpu}" Foreground="{DynamicResource Text.Secondary}" Size="15" />
                        <TextBlock Grid.Column="1"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Style="{StaticResource Value}"
                                   Text="Owned by the Windows kernel. Ports here are usually served by HTTP.sys on behalf of IIS, WinRM or another service registered with Windows." />
                    </Grid>
                </Border>

                <Grid Style="{StaticResource FactRow}" Visibility="{Binding Row.HasExecutablePath, Converter={StaticResource VisibleWhen}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Key}" Text="Executable" />
                    <TextBox Grid.Column="1" AutomationProperties.Name="Executable path" Style="{StaticResource TextBox.Selectable}" Text="{Binding Row.ExecutablePath, Mode=OneWay}" />
                </Grid>
                <Grid Style="{StaticResource FactRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Key}" Text="Started" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding StartedText}" />
                </Grid>
                <Grid Style="{StaticResource FactRow}" Visibility="{Binding HasPublisher, Converter={StaticResource VisibleWhen}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Key}" Text="Publisher" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PublisherText}" />
                </Grid>

                <StackPanel Margin="0,4,0,0" Visibility="{Binding Row.CommandLine, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource Key}" Text="Command line" />
                    <Border Padding="11,9" Background="{DynamicResource Fill.Subtle}" BorderBrush="{DynamicResource Stroke.Hairline}" BorderThickness="1" CornerRadius="8">
                        <TextBox MaxHeight="96"
                                 AutomationProperties.Name="Command line"
                                 Foreground="{DynamicResource Text.Secondary}"
                                 Style="{StaticResource TextBox.Selectable}"
                                 Text="{Binding Row.CommandLine, Mode=OneWay}"
                                 VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>

                <!-- Project & agent -->
                <StackPanel Margin="0,22,0,0" Visibility="{Binding Row.HasProject, Converter={StaticResource VisibleWhen}}">
                    <Border Margin="0,0,0,20" Style="{StaticResource Divider}" />
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Project" />
                    <Grid Style="{StaticResource FactRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Key}" Text="Repository" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource Value}" Text="{Binding Row.ProjectName}" />
                            <Border Margin="6,0,0,0" Padding="5,0" Background="{DynamicResource Fill.Subtle}" CornerRadius="4" Visibility="{Binding Row.IsWorktree, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Style="{StaticResource Text.Micro}" Text="worktree" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource FactRow}" Visibility="{Binding Row.ProjectBranch, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Key}" Text="Branch" />
                        <TextBox Grid.Column="1" Style="{StaticResource TextBox.Selectable}" Text="{Binding Row.ProjectBranch, Mode=OneWay}" />
                    </Grid>
                    <Grid Style="{StaticResource FactRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Key}" Text="Folder" />
                        <TextBox Grid.Column="1" Style="{StaticResource TextBox.Selectable}" Text="{Binding Row.WorkingDirectory, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
                <Border Margin="0,8,0,0" Padding="12,11" Background="{DynamicResource Accent.Soft}" CornerRadius="9" Visibility="{Binding Row.Agent.IsRunning, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Icon Margin="0,1,10,0" VerticalAlignment="Top" Data="{StaticResource Icon.Agent}" Foreground="{DynamicResource Accent}" Size="15" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Row.AgentText}" />
                    </Grid>
                </Border>
                <Border Margin="0,8,0,0" Padding="12,11" Background="{DynamicResource Caution.Soft}" CornerRadius="9">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Row.IsOrphaned}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Row.IsPossiblyLeftBehind}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Icon Margin="0,1,10,0" VerticalAlignment="Top" Data="{StaticResource Icon.Agent}" Foreground="{DynamicResource Caution}" Size="15" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource Value}" Text="Left behind" />
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Text.Secondary}" Style="{StaticResource Value}" Text="{Binding Row.AgentText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Output -->
                <StackPanel Margin="0,22,0,0">
                    <Grid Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Label}" Text="Output" />
                        <Button Width="22" Height="22" HorizontalAlignment="Right" Command="{Binding RefreshLogsCommand}" Style="{StaticResource Button.IconSmall}" ToolTip="Read again" ui:Ui.Icon="{StaticResource Icon.Refresh}" ui:Ui.IconSize="12" />
                    </Grid>
                    <TextBlock Margin="0,0,0,6" FontFamily="{StaticResource Font.Mono}" Style="{StaticResource Text.Micro}" Text="{Binding LogSource}" Visibility="{Binding HasLogs, Converter={StaticResource VisibleWhen}}" />
                    <Border Padding="11,9" Background="{DynamicResource Fill.Subtle}" BorderBrush="{DynamicResource Stroke.Hairline}" BorderThickness="1" CornerRadius="8" Visibility="{Binding HasLogs, Converter={StaticResource VisibleWhen}}">
                        <TextBox MaxHeight="180" FontSize="11" Foreground="{DynamicResource Text.Secondary}" HorizontalScrollBarVisibility="Auto" Style="{StaticResource TextBox.Selectable}" Text="{Binding LogText, Mode=OneWay}" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <TextBlock Foreground="{DynamicResource Text.Tertiary}" Style="{StaticResource Text.Caption}" Text="{Binding LogUnavailable}" TextTrimming="None" TextWrapping="Wrap" Visibility="{Binding HasLogs, Converter={StaticResource HiddenWhen}}" />
                </StackPanel>

                <!-- Siblings -->
                <StackPanel Margin="0,22,0,0" Visibility="{Binding HasSiblings, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Also listening" />
                    <ItemsControl ItemsSource="{Binding Siblings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PortRowViewModel}">
                                <Button Height="28"
                                        Margin="0,0,6,6"
                                        Padding="9,0,10,0"
                                        Command="{Binding DataContext.InspectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource Button.Secondary}"
                                        ToolTip="{Binding EndpointText}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="12" Style="{StaticResource Text.Mono}" Text="{Binding PortText, StringFormat=:{0}}" />
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Micro}" Text="{Binding ProtocolFamilyText}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ───── Danger zone ───── -->
        <Border Grid.Row="2" Padding="24,14,24,18" BorderBrush="{DynamicResource Stroke.Hairline}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Primary}" Text="Terminate process" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Micro}" Text="{Binding TerminateHint}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding DataContext.TerminateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Row}"
                        Content="Terminate"
                        IsEnabled="{Binding IsProtected, Converter={StaticResource Not}}"
                        Style="{StaticResource Button.Danger}"
                        ToolTip="Terminate process  ·  Del"
                        ui:Ui.Icon="{StaticResource Icon.Power}"
                        ui:Ui.IconSize="15" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
