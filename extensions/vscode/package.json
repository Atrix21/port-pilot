{
  "name": "portpilot-dev",
  "displayName": "PortPilot: Ports, Projects & Agents",
  "description": "What's listening on your ports, which project and coding agent it belongs to, whether it's healthy, and what was left behind. Plus an MCP server so agents can ask.",
  "version": "1.0.0",
  "publisher": "Atrix21",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Atrix21/port-pilot"
  },
  "homepage": "https://github.com/Atrix21/port-pilot#in-your-editor",
  "bugs": {
    "url": "https://github.com/Atrix21/port-pilot/issues"
  },
  "galleryBanner": {
    "color": "#141416",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "https://github.com/Atrix21/port-pilot/discussions",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other",
    "Debuggers",
    "AI"
  ],
  "keywords": [
    "port",
    "localhost",
    "EADDRINUSE",
    "dev server",
    "process",
    "kill",
    "mcp",
    "claude"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "portpilot",
          "title": "PortPilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "portpilot": [
        {
          "id": "portpilot.ports",
          "name": "Ports",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "portpilot.ports",
        "contents": "The PortPilot terminal app wasn't found.\n[Install PortPilot](https://github.com/Atrix21/port-pilot/releases/latest)\nOr set `portpilot.cliPath` in Settings.",
        "when": "portpilot.cliMissing"
      }
    ],
    "commands": [
      {
        "command": "portpilot.refresh",
        "title": "Refresh",
        "category": "PortPilot",
        "icon": "$(refresh)"
      },
      {
        "command": "portpilot.toggleScope",
        "title": "Show All Ports / Only This Workspace",
        "category": "PortPilot",
        "icon": "$(filter)"
      },
      {
        "command": "portpilot.cleanup",
        "title": "Clean Up What Agents Left Behind",
        "category": "PortPilot",
        "icon": "$(trash)"
      },
      {
        "command": "portpilot.whoIsOn",
        "title": "Who Is On Port\u2026",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.freePort",
        "title": "Find a Free Port",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.open",
        "title": "Open in Browser",
        "category": "PortPilot",
        "icon": "$(link-external)"
      },
      {
        "command": "portpilot.logs",
        "title": "Show Output",
        "category": "PortPilot",
        "icon": "$(output)"
      },
      {
        "command": "portpilot.health",
        "title": "Check Health",
        "category": "PortPilot",
        "icon": "$(pulse)"
      },
      {
        "command": "portpilot.stop",
        "title": "Stop Process",
        "category": "PortPilot",
        "icon": "$(debug-stop)"
      },
      {
        "command": "portpilot.copyUrl",
        "title": "Copy URL",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.copyPid",
        "title": "Copy PID",
        "category": "PortPilot"
      },
      {
        "command": "portpilot.setupClaude",
        "title": "Set Up Claude Code Integration (hook, watcher, MCP)",
        "category": "PortPilot"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "portpilot.refresh",
          "when": "view == portpilot.ports",
          "group": "navigation@1"
        },
        {
          "command": "portpilot.toggleScope",
          "when": "view == portpilot.ports",
          "group": "navigation@2"
        },
        {
          "command": "portpilot.cleanup",
          "when": "view == portpilot.ports && portpilot.hasLeftovers",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "portpilot.open",
          "when": "view == portpilot.ports && viewItem =~ /http/",
          "group": "inline@1"
        },
        {
          "command": "portpilot.stop",
          "when": "view == portpilot.ports && viewItem =~ /port/",
          "group": "inline@3"
        },
        {
          "command": "portpilot.open",
          "when": "view == portpilot.ports && viewItem =~ /http/",
          "group": "1_open@1"
        },
        {
          "command": "portpilot.logs",
          "when": "view == portpilot.ports && viewItem =~ /port/",
          "group": "1_open@2"
        },
        {
          "command": "portpilot.health",
          "when": "view == portpilot.ports && viewItem =~ /port/",
          "group": "1_open@3"
        },
        {
          "command": "portpilot.copyUrl",
          "when": "view == portpilot.ports && viewItem =~ /port/",
          "group": "2_copy@1"
        },
        {
          "command": "portpilot.copyPid",
          "when": "view == portpilot.ports && viewItem =~ /port/",
          "group": "2_copy@2"
        },
        {
          "command": "portpilot.stop",
          "when": "view == portpilot.ports && viewItem =~ /port/",
          "group": "3_stop@1"
        },
        {
          "command": "portpilot.cleanup",
          "when": "view == portpilot.ports && viewItem =~ /leftovers/",
          "group": "3_stop@2"
        }
      ],
      "commandPalette": [
        {
          "command": "portpilot.open",
          "when": "false"
        },
        {
          "command": "portpilot.logs",
          "when": "false"
        },
        {
          "command": "portpilot.health",
          "when": "false"
        },
        {
          "command": "portpilot.stop",
          "when": "false"
        },
        {
          "command": "portpilot.copyUrl",
          "when": "false"
        },
        {
          "command": "portpilot.copyPid",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "PortPilot",
      "properties": {
        "portpilot.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `portpilot` terminal app. Empty: the copy bundled with the extension, then your `PATH`."
        },
        "portpilot.refreshSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "How often to rescan while the Ports view or status bar is visible."
        },
        "portpilot.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "default": "workspace",
          "description": "Show only ports of the projects open in this window, or every listening port."
        },
        "portpilot.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show this workspace's ports, and leftovers, in the status bar."
        },
        "portpilot.registerMcpServer": {
          "type": "boolean",
          "default": true,
          "description": "Offer the PortPilot MCP server to agents in VS Code (e.g. Copilot agent mode)."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "portpilot.mcp",
        "label": "PortPilot"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
